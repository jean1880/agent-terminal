#!/bin/sh
# A package's scripts run as root for the whole machine and must never touch a user's home, so
# removing the package keeps every user's configuration and data. `agent-terminal --uninstall`
# (run by the user, before the package goes) asks about them. Keep this text in step with the
# rpm's post_uninstall_script (Cargo.toml) and packaging/arch/agent-terminal.install.
set -e

case "$1" in
    # Not purge as well: `apt purge` runs this with remove first, then purge.
    remove)
        cat <<'EOF'
Agent Terminal was removed. Unless you removed it with `agent-terminal --uninstall`, each
user's configuration and data are still in their home folder:
  ~/.config/agent-terminal  ~/.local/state/agent-terminal  ~/.cache/agent-terminal
Delete those folders to remove them.
EOF
        ;;
esac

exit 0
